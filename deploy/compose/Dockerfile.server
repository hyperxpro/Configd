# E2E control-plane image: slim JRE layer over host-built shaded jar.
# Deliberately not the full in-container Maven build: E2E gate runs on 2-vCPU box (host builds serialized).
FROM eclipse-temurin:25-jre-noble

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY configd-server.jar /app/configd-server.jar

# Small heap by design: 6 JVMs must fit the 7.7GB gate box. --enable-preview matches
# the established launch pattern (classes are compiled with the flag; same JDK 25).
ENTRYPOINT ["java", "--enable-preview", \
    "-Xms64m", "-Xmx192m", \
    "-XX:+ExitOnOutOfMemoryError", \
    "-jar", "/app/configd-server.jar"]

# The API serves HTTPS when the TLS triple is on (HttpApiServer wraps the same
# SSLContext) -- -k is fine for a container-local liveness probe.
HEALTHCHECK --interval=5s --timeout=3s --start-period=20s --retries=24 \
    CMD curl -fsSk https://localhost:8080/health/live || exit 1
