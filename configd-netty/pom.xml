<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.configd</groupId>
        <artifactId>configd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>configd-netty</artifactId>

    <!--
      The Netty 4.2 transport-platform module (ADR-0043; decision-log DR-N6).

      Single source of truth for two things shared by every migrated network surface:
        1. NettyTransport — the runtime 3-tier io_uring→Epoll→NIO selector (netty42-api.md §1),
           transport-agnostic (no edge/server coupling); promoted here from configd-edge-node in M2
           so the admin API (configd-server) reuses the SAME selector rather than duplicating it.
        2. The Netty 4.2 HTTP-transport dependency closure (compile scope → transitive), declared
           ONCE here. Migrated surfaces depend on configd-netty and declare NO direct io.netty deps.

      Footprint containment (charter §supply-chain): Netty enters the build ONLY through this module
      and the migrated modules that depend on it (configd-edge-node = M1, configd-server = M2+). It is
      deliberately NOT placed in configd-transport/configd-common — those are depended on by the
      consensus/replication algorithm modules, and pulling Netty there would leak it (and its CVE
      surface) into them. A smaller closure is a smaller CVE surface.

      M4 (DR-N16): this module now also depends on configd-transport — the REVERSE direction of the
      rejected option above (configd-netty -> configd-transport, never the inverse), so configd-transport
      (and thus configd-consensus-core / configd-replication-engine) stays Netty-free while NettyRaftTransport
      can reuse the shared FrameCodec / TlsManager / RaftWireProtocol / RaftTransportEndpoint. No cycle:
      configd-transport does not depend on configd-netty.

      Versions are pinned in the root pom <dependencyManagement> (<netty.version>).
    -->
    <dependencies>
        <!-- M4 (DR-N16): the Netty-free consensus-wire core (FrameCodec, TlsManager, RaftWireProtocol,
             the RaftTransport/RaftTransportEndpoint interfaces, InboundMessage) NettyRaftTransport reuses.
             configd-transport pulls configd-common (NodeId, Clock) transitively. -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-transport</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Transport core + buffers (NIO tier 3 lives in netty-transport; no extra artifact). -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-buffer</artifactId>
        </dependency>
        <!-- HTTP/1.1 codec for the edge-read (M1) and admin (M2) HTTP surfaces. -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
        </dependency>
        <!-- IdleStateHandler (slowloris/idle reaping) + SslHandler (M2 admin server-side TLS, C11). -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>
        <!-- Tier 2: Epoll (Linux). Classes (portable) + native binary (linux-x86_64). -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-classes-epoll</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-x86_64</classifier>
        </dependency>
        <!-- Tier 1: io_uring (Linux ≥5.9). Classes (portable) + native binary (linux-x86_64). -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-classes-io_uring</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-io_uring</artifactId>
            <classifier>linux-x86_64</classifier>
        </dependency>
    </dependencies>
</project>
