<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.configd</groupId>
        <artifactId>configd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>configd-jcstress</artifactId>

    <!--
      B6 / RR-011: jcstress concurrency race-testing harness for the lock-free /
      single-writer-multi-reader structures (VersionedConfigStore, HamtMap,
      FanOutBuffer) and the RR-002 TcpRaftTransport per-peer shared state.

      jcstress is structured exactly like JMH (see configd-testkit): the
      @JCStressTest classes live in src/MAIN/java so they can be bundled into an
      executable uber-jar (jcstress.jar) whose Main-Class is
      org.openjdk.jcstress.Main. The jcstress-core jar is BOTH a compile
      dependency AND the annotation processor that generates the per-test runner
      classes + the META-INF/TestList index the runner discovers tests through.

      Deliberately NOT enable-preview: jcstress forks a fresh JVM per test and
      does not propagate the parent's enable-preview flag to those forks, so a
      preview argLine would make every fork fail to start. The codebase has zero
      preview-feature classes (the flag is vestigial elsewhere), so the harness
      compiles and runs cleanly on a plain release-25 JVM.
    -->

    <dependencies>
        <!-- jcstress runtime + annotation processor (single artifact). -->
        <dependency>
            <groupId>org.openjdk.jcstress</groupId>
            <artifactId>jcstress-core</artifactId>
        </dependency>

        <!-- The structures under test. -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-config-store</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-distribution-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-transport</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- Stable artifact name so the gate + docs can invoke it by path. -->
        <finalName>jcstress</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Override the parent's enable-preview flag (see module comment). -->
                    <release>25</release>
                    <compilerArgs combine.self="override">
                        <arg>-Xlint:all,-processing</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jcstress</groupId>
                            <artifactId>jcstress-core</artifactId>
                            <version>${jcstress.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
              Build the executable jcstress.jar exactly the way configd-testkit
              builds benchmarks.jar (shade + Main-Class + ServicesResourceTransformer),
              with the jcstress-specific resource concatenations: the generated
              META-INF/TestList (the test index the runner discovers tests through)
              and jcstress' aux index files must be APPENDED across jars, never
              clobbered.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>jcstress</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jcstress.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/TestList</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/AuxCounters</resource>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
