<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.configd</groupId>
    <artifactId>configd</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>configd-common</module>
        <module>configd-transport</module>
        <module>configd-netty</module>
        <module>configd-consensus-core</module>
        <module>configd-config-store</module>
        <module>configd-edge-cache</module>
        <module>configd-observability</module>
        <module>configd-replication-engine</module>
        <module>configd-distribution-service</module>
        <module>configd-control-plane-api</module>
        <module>configd-authn-oidc</module>
        <module>configd-kms-vault</module>
        <module>configd-testkit</module>
        <module>configd-server</module>
        <module>configd-edge-node</module>
        <module>configd-linz</module>
        <module>configd-jcstress</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!--
          S7 / supply-chain (E-3): reproducible-build timestamp. A FIXED
          value (NOT a date function) so the maven-jar-plugin (pinned 3.4.2,
          F-0056) stamps every entry's mtime deterministically and zeroes the
          Created-By/Build-Jdk volatility. Bumped only on an intentional
          release. Closes the documented reproducibility gap where the root
          pom set no project.build.outputTimestamp.
        -->
        <project.build.outputTimestamp>2026-06-14T00:00:00Z</project.build.outputTimestamp>
        <!-- S7 / supply-chain (E-1): OWASP dependency-check version, used by
             the -Pcve-scan profile below. Pinned for reproducibility. -->
        <dependency-check.version>12.1.0</dependency-check.version>
        <agrona.version>1.23.1</agrona.version>
        <jctools.version>4.0.5</jctools.version>
        <junit.version>5.11.4</junit.version>
        <jmh.version>1.37</jmh.version>
        <!-- B6 / RR-011: jcstress race-testing harness (configd-jcstress module). -->
        <jcstress.version>0.16</jcstress.version>
        <!--
          Netty transport platform (ADR-0043 supersedes ADR-0037 wholesale): all network
          transport standardizes on Netty 4.2, staged by verification, surface by surface
          (M1 edge-read → M2 admin → M3 fan-out → M4 consensus). Production modules depend on
          Netty as each surface migrates (M1 wires configd-edge-node). The configd-testkit
          head-to-head prototype/benchmarks (docs/jdk-vs-netty/) remain test/bench scope.
          Pinned for reproducibility. API + 3-tier selector: docs/netty-migration/netty42-api.md.
        -->
        <netty.version>4.2.15.Final</netty.version>
        <!-- Config-as-SPI (Group B): the YAML parser for the operator-facing config file. Loaded
             SAFELY (SafeConstructor + resource-exhaustion limits); only configd-server depends on it,
             so the parser never leaks into the lower zero-heavy-dep modules. Pinned for reproducibility. -->
        <snakeyaml.version>2.4</snakeyaml.version>
        <!-- OAuth2/OIDC resource-server (Group B): the JOSE/JWT validation library. Only the optional
             configd-authn-oidc module depends on it, so the JWT SDK never leaks into the core modules.
             Nimbus 10.x is self-contained (its BouncyCastle/Tink deps are optional and unused for the
             RS256/ES256 JDK verification path). Pinned for reproducibility. -->
        <nimbus-jose-jwt.version>10.9</nimbus-jose-jwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.agrona</groupId>
                <artifactId>agrona</artifactId>
                <version>${agrona.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jctools</groupId>
                <artifactId>jctools-core</artifactId>
                <version>${jctools.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.hdrhistogram</groupId>
                <artifactId>HdrHistogram</artifactId>
                <version>2.2.2</version>
            </dependency>
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>1.14.4</version>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>1.9.2</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jcstress</groupId>
                <artifactId>jcstress-core</artifactId>
                <version>${jcstress.version}</version>
            </dependency>
            <!--
              Netty 4.2 transport platform (ADR-0043). Module split per 4.2: native transports
              are separate classes + native-binary (classifier) jars. The io_uring artifacts
              (tier 1 of the io_uring→Epoll→NIO selector, netty42-api.md §1/§2) are managed here
              alongside epoll; both are linux-x86_64-classified native binaries.
            -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-transport</artifactId>
                <version>${netty.version}</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-buffer</artifactId>
                <version>${netty.version}</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec</artifactId>
                <version>${netty.version}</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-http</artifactId>
                <version>${netty.version}</version>
            </dependency>
            <!-- netty-handler: IdleStateHandler (slowloris/idle reaping) now; SslHandler for the
                 fan-out/consensus mTLS surfaces (M3/M4). -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-handler</artifactId>
                <version>${netty.version}</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-transport-classes-epoll</artifactId>
                <version>${netty.version}</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-transport-native-epoll</artifactId>
                <version>${netty.version}</version>
                <classifier>linux-x86_64</classifier>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-transport-classes-io_uring</artifactId>
                <version>${netty.version}</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-transport-native-io_uring</artifactId>
                <version>${netty.version}</version>
                <classifier>linux-x86_64</classifier>
            </dependency>
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${snakeyaml.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>25</release>
                        <compilerArgs>
                            <arg>--enable-preview</arg>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <argLine>--enable-preview</argLine>
                        <systemPropertyVariables>
                            <!-- D-1 (S7.5): unit/integration tests boot servers with the co-located
                                 default signing key (dataDir/signing-key.bin). The production
                                 fail-closed guard (ConfigdServer.enforceSigningKeyNotColocated) would
                                 refuse to start. Tests are a dev context, so opt out module-wide.
                                 Production runs the shaded jar WITHOUT this property and gets
                                 fail-closed; the dedicated negative test sets it false explicitly. -->
                            <configd.security.allowColocatedSigningKey>true</configd.security.allowColocatedSigningKey>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <!--
                  F-0056 fix: pin maven-jar-plugin so builds are reproducible.
                  Previously inherited at whatever version the local Maven
                  installation resolved, which triggered a
                  `build.plugins.plugin.version` warning and could change
                  between runs. 3.4.2 is the latest stable compatible with
                  Maven 3.9 / JDK 25.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <!--
                  Pin maven-clean-plugin for the same reproducibility reason as
                  maven-jar-plugin above (F-0056). Unpinned it resolved to whatever
                  the local Maven default was, so the main `clean install` did not
                  fetch a fixed version into the dependency cache and the OFFLINE
                  gate jobs (gate-2 / phase-0 build the jcstress uber-jar with
                  `-o clean package`) could not resolve it whenever a pom change
                  invalidated the cache. 3.2.0 is the version those gates already
                  request; pinning it makes the online build cache it so the
                  offline gates find it, and keeps the build reproducible.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <!--
                  F-0020 fix: SpotBugs static analysis plugin registered in
                  pluginManagement so every module inherits the configuration.
                  Bound to the `verify` phase; runs only when invoked via
                  `./mvnw spotbugs:spotbugs` or `./mvnw verify`. We set
                  `failOnError=false` initially so existing findings do not
                  break the build — the goal is that the audit can be
                  re-run mechanically.
                -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.9.3.0</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Medium</threshold>
                        <failOnError>false</failOnError>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
                        <xmlOutput>true</xmlOutput>
                        <!--
                          Java 25 bytecode is class-file major version 69.
                          SpotBugs 4.9.3.0 ships ASM 9.7.1 which does not
                          recognize that version — we pin ASM 9.9.1 via
                          plugin dependencies below.
                        -->
                        <fork>true</fork>
                        <spotbugsVersion>4.9.3</spotbugsVersion>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm</artifactId>
                            <version>9.9.1</version>
                        </dependency>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm-analysis</artifactId>
                            <version>9.9.1</version>
                        </dependency>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm-commons</artifactId>
                            <version>9.9.1</version>
                        </dependency>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm-tree</artifactId>
                            <version>9.9.1</version>
                        </dependency>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm-util</artifactId>
                            <version>9.9.1</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>spotbugs-verify</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>spotbugs</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          B3 / RR-085–RR-092: the `-Pmutation` mutation-testing + coverage
          profile. Lives in a PROFILE (not the always-on build) so it never
          slows the default reactor build or gate-1 (PIT is ~25 min/module on
          2 vCPU). gate-2 step (e) activates it.

          Threshold enforcement is per MODULE: the parent only supplies the
          shared plugin configuration (mutators, threads, timeouts, JDK-25
          preview flag, report formats). Each target module's own pom declares
          a `mutation` profile with its `targetClasses` / `excludedClasses` /
          `mutationThreshold` so the build FAILS under threshold
          (charter §4.1). Modules without a `mutation` profile inherit only the
          config and are not mutation-tested.

          Tooling versions are the test-forensics §5 working recipe:
            PIT 1.25.4 + pitest-junit5-plugin 1.2.3 parse JDK-25 class files
            (major 69); JaCoCo 0.8.14 likewise. The `@{argLine}` surefire
            prepend lets JaCoCo's prepare-agent inject its agent while keeping
            the inherited enable-preview flag.
        -->
        <profile>
            <id>mutation</id>
            <properties>
                <!-- Empty default so surefire's late-bound @{argLine} resolves
                     when the JaCoCo agent is absent; prepare-agent overwrites
                     it at runtime. -->
                <argLine></argLine>
            </properties>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-surefire-plugin</artifactId>
                            <configuration>
                                <!-- @{argLine} prepended so the JaCoCo agent
                                     (set via the argLine property) is honoured;
                                     the inherited enable-preview flag is kept. -->
                                <argLine>@{argLine} --enable-preview</argLine>
                            </configuration>
                        </plugin>
                        <plugin>
                            <groupId>org.jacoco</groupId>
                            <artifactId>jacoco-maven-plugin</artifactId>
                            <version>0.8.14</version>
                            <executions>
                                <execution>
                                    <id>mutation-jacoco-prepare</id>
                                    <goals>
                                        <goal>prepare-agent</goal>
                                    </goals>
                                </execution>
                                <execution>
                                    <id>mutation-jacoco-report</id>
                                    <phase>test</phase>
                                    <goals>
                                        <goal>report</goal>
                                    </goals>
                                </execution>
                            </executions>
                        </plugin>
                        <plugin>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-maven</artifactId>
                            <version>1.25.4</version>
                            <dependencies>
                                <dependency>
                                    <groupId>org.pitest</groupId>
                                    <artifactId>pitest-junit5-plugin</artifactId>
                                    <version>1.2.3</version>
                                </dependency>
                            </dependencies>
                            <configuration>
                                <mutators>
                                    <mutator>DEFAULTS</mutator>
                                </mutators>
                                <threads>2</threads>
                                <timeoutConstant>8000</timeoutConstant>
                                <timeoutFactor>1.5</timeoutFactor>
                                <jvmArgs>
                                    <jvmArg>--enable-preview</jvmArg>
                                </jvmArgs>
                                <outputFormats>
                                    <outputFormat>XML</outputFormat>
                                    <outputFormat>HTML</outputFormat>
                                </outputFormats>
                                <timestampedReports>false</timestampedReports>
                                <!-- Default: do not fail when no targetClasses
                                     are declared (so non-target modules are
                                     inert under -Pmutation). Target modules
                                     override failWhenNoMutations + threshold. -->
                                <failWhenNoMutations>false</failWhenNoMutations>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          S7 / supply-chain (E-1): OWASP dependency-check CVE scan.

          Lives in a PROFILE so the default reactor build / gate-1 never pay
          for it: dependency-check downloads and updates the NVD data feed
          (large; network) which is slow and unsuitable for the inner loop.
          gate-7's CVE step activates it.

          Fails the build on CVSS >= 7.0 (HIGH / CRITICAL) via
          failBuildOnCVSS. NOTE: most Configd dependencies that are NOT
          Agrona / JCTools / Micrometer / HdrHistogram are test-scope
          (JUnit, JMH, jqwik, jcstress) — a CVE there is not shipped in the
          runtime image, but we DO NOT auto-skip test scope: triage is by
          finding, not by a blanket skipTestScope filter that could mask a
          build-time supply-chain risk.

          CI invocation (Seam 6 / gate-7), run from repo root (see
          docs/session-7/supply-chain.md E-1 for the copy-paste command;
          the leading double-dash flags are omitted here because XML
          comments forbid a double-dash sequence):
            ./mvnw -Pcve-scan org.owasp:dependency-check-maven:aggregate
              -DfailBuildOnCVSS=7 -Dformats=HTML,JSON,SARIF
              -DnvdApiKey=$NVD_API_KEY
          (an NVD API key drastically speeds the feed update; without it the
          update is heavily rate-limited.)
        -->
        <profile>
            <id>cve-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.version}</version>
                        <configuration>
                            <!-- Fail on CVSS >= 7.0 (HIGH / CRITICAL). -->
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <!-- Machine- and human-readable outputs; SARIF
                                 lets gate-7 surface findings in the GitHub
                                 Security tab if the lead wires it. -->
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                                <format>SARIF</format>
                            </formats>
                            <!-- Aggregate report at the reactor root. -->
                            <outputDirectory>${maven.multiModuleProjectDirectory}/target/dependency-check</outputDirectory>
                            <!-- Suppression file: empty/optional today; the
                                 path is declared so a triaged false-positive
                                 can be suppressed-with-justification via an
                                 ADR rather than by lowering the threshold. -->
                            <suppressionFiles>
                                <suppressionFile>${maven.multiModuleProjectDirectory}/dependency-check-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                            <!-- The .NET / Node / Python / Ruby analyzers are
                                 irrelevant to a pure-Java reactor; disabling
                                 them trims runtime and false positives. -->
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                            <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
