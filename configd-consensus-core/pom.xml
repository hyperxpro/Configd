<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.configd</groupId>
        <artifactId>configd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>configd-consensus-core</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-transport</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jctools</groupId>
            <artifactId>jctools-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              B4 / RR-003 reuse seam: publish this module's TEST classes as a
              test-jar so configd-testkit's adversarial simulation can consume the
              crash-capable durability fixtures (CrashStorage, KvStateMachine)
              without duplicating them. testkit(main/test) -> consensus-core(test-jar)
              is acyclic; the reverse direction would cycle, so the test-jar must be
              produced here and consumed there. Lead decision (S2 risky-point #1).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          B3 / RR-085: consensus-core mutation thresholds (charter §4.1).
          Activated with the parent `-Pmutation` profile, which supplies the
          shared PIT/JaCoCo plugin config; this module adds the targetClasses
          split and the enforced thresholds.

          TWO enforced runs (gate-2 step (e) runs both):
            * `mutation`        — MODULE-WIDE, mutationThreshold 70 over the
                                  whole consensus package.
            * `mutation-kernel` — the SAFETY KERNEL only, mutationThreshold 80.

          SAFETY-KERNEL DEFINITION (the "election/log/commit/persistence"
          classes, by class because the whole module is one package
          io.configd.raft):
            RaftNode          — election, commit-rule (§5.4.2), leader/append,
                                ReadIndex dispatch, snapshot install.
            RaftLog           — the log + WAL persistence/truncation/compaction
                                (durable-prefix).
            DurableRaftState  — term + vote persistence (Election Safety).
            ReadIndexState    — linearizable-read commit/confirmation state.
            ClusterConfig     — quorum / joint-consensus membership math.
          The remaining classes are the sealed RaftMessage records, enums
          (RaftRole), the small value types (LogEntry, SnapshotState,
          CommitOutcome, ProposeOutcome, ProposalResult, RaftConfig,
          RaftMetrics) and the RaftTransport/StateMachine SAM interfaces —
          boilerplate/value carriers, not the safety logic; they count toward
          the 70 module-wide bar but are NOT held to the 80 kernel bar.

          No shelfware is excluded here: every consensus-core class is live on
          the consensus path.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses>
                                <param>io.configd.raft.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.configd.raft.*</param>
                            </targetTests>
                            <mutationThreshold>70</mutationThreshold>
                            <failWhenNoMutations>true</failWhenNoMutations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>mutation-kernel</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses>
                                <param>io.configd.raft.RaftNode*</param>
                                <param>io.configd.raft.RaftLog*</param>
                                <param>io.configd.raft.DurableRaftState*</param>
                                <param>io.configd.raft.ReadIndexState*</param>
                                <param>io.configd.raft.ClusterConfig*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.configd.raft.*</param>
                            </targetTests>
                            <mutationThreshold>80</mutationThreshold>
                            <failWhenNoMutations>true</failWhenNoMutations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
