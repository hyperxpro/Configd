<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.configd</groupId>
        <artifactId>configd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>configd-distribution-service</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-wire</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-config-store</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-transport</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jctools</groupId>
            <artifactId>jctools-core</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Activated with the parent -Pmutation flag. This module mixes a live control
          plane, the commit-notification boundary plus the active watch and
          dissemination path, with shelfware: edge-data-plane fan-out and gossip
          machinery that is blocked on a future implement-or-descope decision.

          The control plane is held to mutationThreshold 65. The shelfware is excluded
          explicitly and listed here, never silently omitted, so an exclusion can never
          quietly mask a real coverage gap.

          Control-plane targetClasses (held to 65):
            CommitNotification, CommitNotificationSource, FanOutBuffer,
            FanOutMetrics, ReplaySource, SnapshotReplaySource (the commit-notification
                boundary, the control plane consumed downstream);
            WatchService, WatchCoalescer, WatchEvent, SubscriptionManager,
            PlumtreeNode, RolloutController (the active watch, dissemination, and
                rollout control plane);
            io.configd.distribution.wire.* (the edge protocol model plus
                EdgeFrameCodec and EdgeSnapshotCodec);
            io.configd.distribution.fanout.* (FanOutSessionCore plus its config,
                sink, metrics, and demotion seams).

          Excluded shelfware (no consumer-facing wire path exists yet, so it is
          tracked here but not held to a bar):
            HyParViewOverlay - gossip membership overlay; failure-repair machinery
                               untested, pending the edge data plane.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses>
                                <param>io.configd.distribution.CommitNotification*</param>
                                <param>io.configd.distribution.FanOut*</param>
                                <param>io.configd.distribution.ReplaySource*</param>
                                <param>io.configd.distribution.SnapshotReplaySource*</param>
                                <param>io.configd.distribution.WatchService*</param>
                                <param>io.configd.distribution.WatchCoalescer*</param>
                                <param>io.configd.distribution.WatchEvent*</param>
                                <param>io.configd.distribution.SubscriptionManager*</param>
                                <param>io.configd.distribution.PlumtreeNode*</param>
                                <param>io.configd.distribution.RolloutController*</param>
                                <param>io.configd.distribution.wire.*</param>
                                <param>io.configd.distribution.fanout.*</param>
                            </targetClasses>
                            <excludedClasses>
                                <param>io.configd.distribution.HyParViewOverlay*</param>
                            </excludedClasses>
                            <targetTests>
                                <param>io.configd.distribution.*</param>
                                <param>io.configd.distribution.wire.*</param>
                                <param>io.configd.distribution.fanout.*</param>
                            </targetTests>
                            <mutationThreshold>65</mutationThreshold>
                            <failWhenNoMutations>true</failWhenNoMutations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
