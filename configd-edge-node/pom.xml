<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.configd</groupId>
        <artifactId>configd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>configd-edge-node</artifactId>

    <!--
      C2 (Session 3): the separately runnable edge node process (RR-001).
      Internal runtime deps: JDK sockets + TlsManager (configd-transport),
      EdgeClientCore + edge cache (configd-edge-cache), the edge wire protocol
      (configd-distribution-service), Ed25519 verification (configd-config-store,
      via edge-cache), metrics/invariants (configd-observability).

      Netty transport (ADR-0043, supersedes ADR-0037): M1 migrates the edge-read HTTP
      surface (EdgeHttpServer) to Netty 4.2, so Netty is now a PRODUCTION (compile-scope)
      dependency here — the one new third-party runtime dependency ADR-0043 deliberately
      prices in. HTTP-codec + transport + the Epoll (tier 2) and io_uring (tier 1) native
      transports; NIO (tier 3) is in netty-transport (no extra artifact). The native
      binaries are linux-x86_64; non-Linux / sandboxed runs fall through to NIO at runtime
      (netty42-api.md §1). Versions managed in the root pom dependencyManagement.
    -->
    <dependencies>
        <dependency><groupId>io.configd</groupId><artifactId>configd-common</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-transport</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-config-store</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-edge-cache</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-distribution-service</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-observability</artifactId><version>${project.version}</version></dependency>

        <!-- Netty 4.2 transport platform (ADR-0043) — PRODUCTION scope (M1 edge-read HTTP). -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-buffer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
        </dependency>
        <!-- IdleStateHandler (slowloris/idle reaping); SslHandler later for fan-out/consensus mTLS. -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>
        <!-- Tier 2: Epoll (Linux). Classes (portable) + native binary (linux-x86_64). -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-classes-epoll</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-x86_64</classifier>
        </dependency>
        <!-- Tier 1: io_uring (Linux ≥5.9). Classes (portable) + native binary (linux-x86_64). -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-classes-io_uring</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-io_uring</artifactId>
            <classifier>linux-x86_64</classifier>
        </dependency>

        <!--
          TEST-ONLY: the process-level tests (EdgeNodeIntegrationTest, EdgeFailoverTest,
          EdgeStrongReadFailClosedTest) drive a REAL single-node ConfigdServer + its
          FanOutServer over loopback, exactly the FanOutServerIntegrationTest pattern.
          Test scope only — the runnable edge artifact never depends on the server.
        -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-server</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.configd.edge.node.EdgeNodeMain</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- Runnable shaded jar, mirroring configd-server's shade setup. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.configd.edge.node.EdgeNodeMain</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          C2 day-one mutation profile (charter §4.1; RR-085 lesson: explicit
          targetClasses, never blanket globs). Activated with the parent -Pmutation.

          targetClasses (held to 65):
            EdgeNodeConfig  — CLI parsing/validation (pure decision logic);
            EdgeReadHandler — the read-serving decision surface (ADR-0043 DR-N2): cursor-behind
                              refusal, strong-read fail-close, stale header, not-subscribed,
                              health gating, the /metrics Bearer gate (the CT-03/05/12/37 clauses).
                              The transport-agnostic logic both HTTP adapters delegate to;
            EdgeHttpServer  — the (now thin) JDK adapter: routing dispatch + the JdkSink;
            EdgeNodeMetrics — series registration + delta-pump + the CT-04
                              STALE-transition counter and the DISCONNECTED
                              re-bootstrap trigger seam.

          NettyEdgeHttpServer / NettyTransport are EXCLUDED for the same reason as EdgeStreamClient:
          pure transport-IO orchestration (event loops, native transport selection, socket framing)
          whose per-mutant run needs a live server/port — the per-mutant-fork instability RR-085/092
          forbid. Their decision content lives in EdgeReadHandler (covered above); their IO + the
          slowloris/size hardening are pinned by NettyEdgeHttpServerTest + NettyEdgeHttpServerHardeningTest.

          EXCLUDED (justified, pure-IO wiring — each would need a live socket /
          TLS handshake / multi-thread process per mutant, which is exactly the
          per-mutant-fork instability RR-085/RR-092 forbid):
            EdgeStreamClient — connect/mTLS/reconnect virtual-thread shell; its
                               logic is the EdgeClientCore directives (already
                               mutation-tested in configd-edge-cache — C3 added the
                               PoisonPillPolicy ladder there too); the C3 additions here
                               (requestRebootstrap teardown, terminal-action invoke,
                               poison resume-cursor derivation) are pure IO orchestration
                               pinned by the process-level EdgeReBootstrapOnDisconnectTest
                               and PoisonPillRebootstrapTest, which are too heavy
                               (real server + Raft) for per-mutant runs;
            EdgeNodeMain     — lifecycle orchestration (start/stop/wiring), no
                               branching policy beyond what EdgeNodeConfig owns.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses>
                                <param>io.configd.edge.node.EdgeNodeConfig*</param>
                                <param>io.configd.edge.node.EdgeReadHandler*</param>
                                <param>io.configd.edge.node.EdgeHttpServer*</param>
                                <param>io.configd.edge.node.EdgeNodeMetrics*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.configd.edge.node.EdgeNodeConfigTest</param>
                                <param>io.configd.edge.node.EdgeHttpServerTest</param>
                                <param>io.configd.edge.node.EdgeNodeMetricsTest</param>
                            </targetTests>
                            <mutationThreshold>65</mutationThreshold>
                            <failWhenNoMutations>true</failWhenNoMutations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
