<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.configd</groupId>
        <artifactId>configd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>configd-edge-cache</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-config-store</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          InvariantMonitor is used by StalenessTracker and LocalConfigStore to emit
          monotonic-read / staleness-bound violations.
        -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          EdgeClientCore consumes the edge wire types (EdgeFrame, EdgeSnapshotCodec,
          CommitNotification) from the distribution service. No cycle:
          configd-distribution-service does NOT depend on configd-edge-cache (verified —
          its deps are common/config-store/transport/agrona/jctools only), so this
          edge→distribution edge is acyclic. The transport-agnostic wire model carries no
          java.net/socket types, so EdgeClientCore stays transport-free.
        -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-distribution-service</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Mutation-testing discipline. Activated with the parent `-Pmutation`. Scoped
          explicitly to this module's edge data-plane classes rather than a blanket package
          glob, so the score is not dragged down by pre-existing edge classes with lower
          coverage.

          targetClasses (held to 65):
            EdgeClientCore        — the transport-agnostic client session engine, including
                                    the gap/DISCONNECTED resubscribe directives and the
                                    poison-pill wiring;
            StalenessTracker      — the covered-frontier staleness measure;
            EdgeConfigClient      — the storage filter + frontier wiring;
            PrefixStorageFilter   — the storage-filter helper;
            StrongReadKeyClass    — the shared strong-read predicate;
            DeltaApplier          — the commit-timestamp-driven apply/gap logic;
            PoisonPillPolicy      — the bounded-retry/quarantine/terminal ladder.
                                    PoisonPillDetector is referenced by it but its own code
                                    is unchanged, so it keeps its pre-existing tests and is
                                    not itself a target.

          Pre-existing edge classes NOT raised here (LocalConfigStore, PrefixSubscription,
          VersionCursor, EdgeMetrics) are out of scope; their bars stay where their own
          coverage put them. PIT glob `Foo*` does NOT recurse subpackages, but io.configd.edge
          is flat, so the explicit class names suffice.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses>
                                <param>io.configd.edge.EdgeClientCore*</param>
                                <param>io.configd.edge.StalenessTracker*</param>
                                <param>io.configd.edge.EdgeConfigClient*</param>
                                <param>io.configd.edge.PrefixStorageFilter*</param>
                                <param>io.configd.edge.StrongReadKeyClass*</param>
                                <param>io.configd.edge.DeltaApplier*</param>
                                <param>io.configd.edge.PoisonPillPolicy*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.configd.edge.EdgeClientCoreTest</param>
                                <param>io.configd.edge.StalenessTrackerTest</param>
                                <param>io.configd.edge.StalenessSkewTripwireTest</param>
                                <param>io.configd.edge.EdgeConfigClientTest</param>
                                <param>io.configd.edge.EdgePrefixStorageFilterTest</param>
                                <param>io.configd.edge.StrongReadKeyClassTest</param>
                                <param>io.configd.edge.DeltaApplierTest</param>
                                <param>io.configd.edge.LocalConfigStoreTest</param>
                                <param>io.configd.edge.PoisonPillRebootstrapTest</param>
                            </targetTests>
                            <mutationThreshold>65</mutationThreshold>
                            <failWhenNoMutations>true</failWhenNoMutations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
