<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.configd</groupId>
        <artifactId>configd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>configd-server</artifactId>

    <dependencies>
        <dependency><groupId>io.configd</groupId><artifactId>configd-common</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-consensus-core</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-config-store</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-replication-engine</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-distribution-service</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-transport</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-control-plane-api</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-edge-cache</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.configd</groupId><artifactId>configd-observability</artifactId><version>${project.version}</version></dependency>
        <!-- Netty 4.2 platform (ADR-0043): the shared transport selector + the HTTP-transport
             dep closure, used by the Netty admin-API adapter (NettyHttpApiServer). PRODUCTION scope. -->
        <dependency><groupId>io.configd</groupId><artifactId>configd-netty</artifactId><version>${project.version}</version></dependency>
        <!-- Config-as-SPI: YAML parser for the operator-facing config file. Confined to
             configd-server (the YamlConfigSource lives here) so it never enters the lower modules. -->
        <dependency><groupId>org.yaml</groupId><artifactId>snakeyaml</artifactId></dependency>

        <!-- Live E2E ONLY (EncryptedClusterVaultKmsIT): puts the optional Vault KMS module
             (its VaultKmsProviderFactory + META-INF/services entry) and a real Vault container on the
             TEST classpath so a full ConfigdServer cluster can seal/unseal its at-rest keyring through a
             real Vault Transit. TEST SCOPE: the core still never compile-depends on configd-kms-vault, so
             this changes nothing about the production classpath or the "no Vault client in core" property -
             it only lets the end-to-end test exercise the ServiceLoader boot path the provider unit test
             cannot. Testcontainers versions pinned locally, matching configd-kms-vault's own Vault IT. -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-kms-vault</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>1.20.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>vault</artifactId>
            <version>1.20.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.configd.server.ConfigdServer</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.configd.server.ConfigdServer</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          configd-server seam mutation MEASUREMENT. The primary before/after
          evidence is JaCoCo coverage (parent `-Pmutation` wires prepare-agent +
          report). This profile additionally measures mutation strength over the
          correctness-bearing seam classes — the HTTP handler + auth gate, arg
          parsing, the transport adapter, and the wire codec — so the new
          HTTP-level / loopback tests can be shown to KILL mutants, not just
          execute lines.

          No hard mutationThreshold gate here: configd-server is NOT one of the
          three gate-enforced bars (consensus-core 70/80, distribution-service
          65), and a full-module ConfigdServer PIT run is heavy and starts
          background sockets/executors. We scope to the seam classes and let
          gate-2 enforce the consensus/distribution bars.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses>
                                <!-- The admin-API decision seam is AdminApiHandler — the shared
                                     transport-agnostic logic both the JDK and Netty adapters delegate to.
                                     NettyHttpApiServer (like NettyEdgeHttpServer in configd-edge-node) is
                                     EXCLUDED: pure transport-IO orchestration whose per-mutant run needs a
                                     live socket/event loop (per-mutant-fork instability); its decision
                                     content lives in AdminApiHandler and its IO + the slowloris/size
                                     hardening are pinned by the contract + hardening tests. -->
                                <param>io.configd.server.AdminApiHandler*</param>
                                <param>io.configd.server.HttpApiServer*</param>
                                <param>io.configd.server.ServerConfig*</param>
                                <param>io.configd.server.RaftTransportAdapter*</param>
                                <param>io.configd.server.RaftMessageCodec*</param>
                                <param>io.configd.server.StrongReadPolicy*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.configd.server.*</param>
                            </targetTests>
                            <failWhenNoMutations>true</failWhenNoMutations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
