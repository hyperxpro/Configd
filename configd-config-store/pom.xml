<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.configd</groupId>
        <artifactId>configd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>configd-config-store</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-wire</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-consensus-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          B3 / RR-092: config-store mutation measurement. The module is already
          above the 60 line (Session-1 71%); RR-092 closes specific point holes
          (delete/applyBatch version-regression guards; decodeTrailer boundary
          checks). This profile measures the whole store package and locks a 70
          regression floor so a future change that re-opens those holes fails
          the gate. Not one of the three charter §4.1 gate-2-enforced bars
          (those are consensus-core 70/80 and distribution-service 65), but
          wired so RR-092's gains are durable.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses>
                                <param>io.configd.store.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.configd.store.*</param>
                            </targetTests>
                            <mutationThreshold>70</mutationThreshold>
                            <failWhenNoMutations>true</failWhenNoMutations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
