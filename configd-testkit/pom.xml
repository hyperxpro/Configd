<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.configd</groupId>
        <artifactId>configd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>configd-testkit</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-consensus-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          B4: consume consensus-core's test-jar so the adversarial simulation can
          reuse the RR-003 crash-capable durability fixtures (CrashStorage,
          KvStateMachine) instead of duplicating them. Test scope: only the sim's
          own tests use these fixtures.
        -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-consensus-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-config-store</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-edge-cache</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-distribution-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          S3 Phase V2 (charter §3 V2): LivePropagationProbeMain starts an in-process
          single-node ConfigdServer and tails its ADR-0034 commit-notification boundary
          to measure live commit->boundary propagation. This is an internal reactor
          module (no new external dependency); configd-server does NOT depend on
          configd-testkit in any scope, so the reactor simply topologically orders
          configd-server before configd-testkit — no cycle.
        -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-transport</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          S3 Phase V2 (charter §3 V2): the synthetic propagation probe records
          staleness distributions via HdrHistogram (PropagationProbe, io.configd.probe).
          Version is pinned in the root pom dependencyManagement (2.2.2); this is an
          already-managed dependency, NOT a new external one. It is already present
          transitively on the test classpath (observability → LatencyUtils), declared
          here explicitly because the probe lives in src/main/java.
        -->
        <dependency>
            <groupId>org.hdrhistogram</groupId>
            <artifactId>HdrHistogram</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <!--
          F-0043: JMH benchmarks live under src/main/java/io/configd/bench so
          they can be bundled into an executable uber-jar (benchmarks.jar).
          JMH is therefore a compile-scope dependency. We mark it optional so
          consumers of the thin testkit jar do not pull it transitively.
        -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
              F-0043 fix: bundle benchmarks + jmh-core into an executable
              uber-jar so CI and docs can run them via:
                java -jar configd-testkit/target/benchmarks.jar <regex>
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>benchmarks</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!--
                                  JMH-generated metadata files must be concatenated
                                  across jars, not clobbered.
                                -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/BenchmarkList</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/CompilerHints</resource>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
