{
  "title": "Configd Control Plane (Raft + write path)",
  "uid": "configd-control-plane",
  "tags": ["configd", "control-plane", "raft"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [{"name": "cluster", "type": "query", "label": "Cluster", "query": "label_values(configd_write_commit_total, cluster)", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
  "panels": [
    {
      "id": 1, "title": "Write commit p99 (target < 150 ms)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(configd_write_commit_seconds_bucket{cluster=\"$cluster\"}[5m])))", "legendFormat": "p99", "refId": "A"},
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(configd_write_commit_seconds_bucket{cluster=\"$cluster\"}[5m])))", "legendFormat": "p50", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.150}]}}}
    },
    {
      "id": 2, "title": "State-machine apply p99 (apply_seconds)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(configd_apply_seconds_bucket{cluster=\"$cluster\"}[5m])))", "legendFormat": "apply p99", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 3, "title": "Write throughput + outcomes (rate/s)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(configd_write_commit_total{cluster=\"$cluster\"}[5m]))", "legendFormat": "committed", "refId": "A"},
        {"expr": "sum(rate(configd_write_commit_failed_total{cluster=\"$cluster\"}[5m]))", "legendFormat": "failed", "refId": "B"},
        {"expr": "sum(rate(configd_write_rejected_overloaded_total{cluster=\"$cluster\"}[5m]))", "legendFormat": "429 shed", "refId": "C"}
      ]
    },
    {
      "id": 4, "title": "Raft apply backlog (commitIndex − lastApplied)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "configd_raft_pending_apply_entries{cluster=\"$cluster\"}", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5000}]}}}
    },
    {
      "id": 5, "title": "Term changes / min (leader churn, max across nodes)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [{"expr": "max(rate(configd_raft_elections_total{cluster=\"$cluster\"}[5m])) * 60", "legendFormat": "term changes/min", "refId": "A"}]
    },
    {
      "id": 6, "title": "Snapshot install failures + subscribed prefixes", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(increase(configd_snapshot_install_failed_total{cluster=\"$cluster\"}[15m]))", "legendFormat": "install failures (15m)", "refId": "A"},
        {"expr": "max(configd_subscription_prefix_count{cluster=\"$cluster\"})", "legendFormat": "subscribed prefixes", "refId": "B"}
      ]
    }
  ]
}
