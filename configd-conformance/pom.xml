<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.configd</groupId>
        <artifactId>configd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>configd-conformance</artifactId>

    <!--
      The conformance / real-server E2E module: it is the one place that sees BOTH the thin reference client
      (configd-client-*) and the real server (configd-server + the fan-out data plane), so it drives the client
      against a live FanOutServer. This keeps the thin client's own test scope free of the server (the
      thin-client thesis) while still proving real interop, and hosts the two-runner conformance suite
      (client-conforms / server-obeys-RFC). Deps are compile-scope so the (test-only) sources see both sides.
    -->
    <dependencies>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-client-edge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Test-only: reuse MockEdgeServer + StreamFixtures for the edge (0x02 watch) client-conforms direction. -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-client-edge</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-client-http</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Test-only: reuse MockControlPlane for the HTTP client-conforms direction. -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-client-http</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-client-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-distribution-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-wire</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Test-only: reuse EdgeFrameGoldenBytes (the pinned wire vectors) as the golden round-trip oracle. -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-wire</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: the JUnit Platform Launcher, for the coverage audit to discover clause tags. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Failsafe runs the fuller live edge sweep (EncryptedFilteredSignedEdgeSweepIT) as part of the
              integration-test/verify phase so it gets a standing signal on every build instead of only in
              ad-hoc manual sessions. The sweep is self-contained: it boots a single ConfigdServer in-process
              over loopback with ephemeral ports (empty peer list, so the node self-elects), so it needs no
              Docker and no external cluster and runs on the ordinary GitHub-hosted runner as part of
              `mvn install`. The include list
              is pinned to just this one IT on purpose: the other *IT classes in this module boot a real
              multi-node cluster (RealClusterFailoverIT) and are left out of the always-on path so a PR is not
              newly gated on a heavier failover run. verify (not just integration-test) is bound so an IT
              failure actually fails the build.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-preview</argLine>
                    <includes>
                        <include>**/EncryptedFilteredSignedEdgeSweepIT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <!-- Mirror the surefire posture so an IT that boots a server behaves the same as the
                             unit tests: the sweep keeps its signing key outside the data dir, but the shorter
                             shutdown drain keeps the suite fast. -->
                        <configd.security.allowColocatedSigningKey>true</configd.security.allowColocatedSigningKey>
                        <configd.shutdown.drainQuietMs>0</configd.shutdown.drainQuietMs>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
