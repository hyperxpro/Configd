<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.configd</groupId>
        <artifactId>configd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>configd-conformance</artifactId>

    <!-- Conformance E2E: drives thin client against live FanOutServer; thin client stays free of server. -->
    <dependencies>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-client-edge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Test-jar: reuse MockEdgeServer + StreamFixtures. -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-client-edge</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-client-http</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Test-jar: reuse MockControlPlane. -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-client-http</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-client-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-distribution-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-wire</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Test-jar: reuse EdgeFrameGoldenBytes (pinned wire vectors). -->
        <dependency>
            <groupId>io.configd</groupId>
            <artifactId>configd-wire</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Failsafe: include only EncryptedFilteredSignedEdgeSweepIT (RealClusterFailoverIT excluded to keep PRs fast). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-preview</argLine>
                    <includes>
                        <include>**/EncryptedFilteredSignedEdgeSweepIT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <!-- Mirror the surefire posture so an IT that boots a server behaves the same as the
                             unit tests: the sweep keeps its signing key outside the data dir, but the shorter
                             shutdown drain keeps the suite fast. -->
                        <configd.security.allowColocatedSigningKey>true</configd.security.allowColocatedSigningKey>
                        <configd.shutdown.drainQuietMs>0</configd.shutdown.drainQuietMs>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
